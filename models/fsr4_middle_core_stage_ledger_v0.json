{
  "schema": "com.apusr.middle_core_stage_ledger.v0",
  "status": "canonical_planning_contract_for_spatial_core_stage1_to_12",
  "source_note": "This ledger bridges the logical FSR4 INT8 middle core and APUSR's physical NPU implementation. It records every NPU-owned logical stage 1..12. The older fsr4_middle_core_v0.json file only lists same-scale planning blocks and must not be used as the complete stage list.",
  "npu_owned_logical_stage_range": [
    1,
    12
  ],
  "model_family": "fsr4_int8_shape",
  "parameter_profile": "am020_4x4_base",
