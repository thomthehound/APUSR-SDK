    "npu_middle_core": [
      1,
      12
    ],
    "gpu_egress_bookend": 13,
    "ingress_layout": "zero_guarded_row_major_c16_frame",
    "internal_layout": "m4x8_block_major_c32_c64_after_front",
    "egress_layout": "m4x8_cell_major_c16_frame"
  },
  "ledger_rules": {
    "kernel_owns_physical_parameter_format": true,
    "source_model_owns_tensor_meaning_only": true,
    "resident_parameters_load_at_model_epoch": true,
    "hot_path_parameter_streams": 0,
    "current_resident_slices_are_seed_contracts_not_sacred_layouts": true,
    "logical_transition_stages_are_first_class_work": true,
    "allow_visual_discontinuity_on_epoch_switch": true,
    "forbid_resident_mutation_while_old_work_can_read": true
  },
  "activation_cell_shapes": {
    "c16_cell": {
      "width": 16,
      "rows": 8,
      "channels": 16,
      "bytes": 2048,
      "layout": "stage_specific_c16_cell; row_major at ingress-facing front, m4x8 at public egress"
    },
    "c16_halo_cell": {
      "width": 18,
      "rows": 10,
      "channels": 16,
      "bytes": 2880,
      "layout": "stage_specific_c16_halo_view; front uses row-major tensor DMA, decoder layout is owned by the stage12 primitive"
