#include <winres.h>

#define APUSR_FRAMEGEN_VERSION_MAJOR 3
#define APUSR_FRAMEGEN_VERSION_MINOR 1
#define APUSR_FRAMEGEN_VERSION_PATCH 5

#define APUSR_RC_STR2(value) #value
#define APUSR_RC_STR(value) APUSR_RC_STR2(value)
#define APUSR_FRAMEGEN_VERSION_STRING \
    APUSR_RC_STR(APUSR_FRAMEGEN_VERSION_MAJOR) "." \
    APUSR_RC_STR(APUSR_FRAMEGEN_VERSION_MINOR) "." \
    APUSR_RC_STR(APUSR_FRAMEGEN_VERSION_PATCH) ".0"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APUSR_FRAMEGEN_VERSION_MAJOR, APUSR_FRAMEGEN_VERSION_MINOR, APUSR_FRAMEGEN_VERSION_PATCH, 0
 PRODUCTVERSION APUSR_FRAMEGEN_VERSION_MAJOR, APUSR_FRAMEGEN_VERSION_MINOR, APUSR_FRAMEGEN_VERSION_PATCH, 0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "APUSR"
            VALUE "FileDescription", "APUSR Frame Generation DX12 Provider (FidelityFX-compatible)"
            VALUE "FileVersion", APUSR_FRAMEGEN_VERSION_STRING
            VALUE "LegalCopyright", "Copyright (c) 2026 thomthehound; FidelityFX-derived components retain AMD notices"
            VALUE "OriginalFilename", "amd_fidelityfx_framegeneration_dx12.dll"
            VALUE "ProductName", "APUSR Frame Generation"
            VALUE "ProductVersion", APUSR_FRAMEGEN_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
